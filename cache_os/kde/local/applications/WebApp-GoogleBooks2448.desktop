[Desktop Entry]
Version=1.0
Name=Google Books
Comment=Aplikacja internetowa
Exec=google-chrome-stable --app="https://play.google.com/books" --class=WebApp-GoogleBooks2448 --name=WebApp-GoogleBooks2448 --user-data-dir=__HOME__/.local/share/ice/profiles/GoogleBooks2448
Terminal=false
X-MultipleArgs=false
Type=Application
Icon=__HOME__/.local/share/ice/icons/GoogleBooks.png
Categories=GTK;WebApps;
MimeType=text/html;text/xml;application/xhtml_xml;
StartupWMClass=WebApp-GoogleBooks2448
StartupNotify=true
X-WebApp-Browser=Chrome
X-WebApp-URL=https://play.google.com/books
X-WebApp-CustomParameters=
X-WebApp-Navbar=false
X-WebApp-PrivateWindow=false
X-WebApp-Isolated=true

