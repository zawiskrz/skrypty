configuration {
    modi: "drun,run";
    show-icons: true;
    icon-theme: "Papirus";
    drun-display-format: "{name}";
}

@theme "Arc-Dark"

element {
    orientation: vertical;
    padding: 15px;
    spacing: 10px;
}

element-icon {
    size: 48px;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
}

listview {
    columns: 4;
    lines: 3;
    spacing: 10px;
    cycle: false;
}

window {
    width: 45%;
}
